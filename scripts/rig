#!/usr/bin/env python3
"""rig: drive atlh runner machines from the workstation.

Runners are listed in runners.toml (repo root). Each command runs on one
runner: -r NAME, else $ATLH_RUNNER, else `default` in runners.toml.
See docs/rig.md for a walkthrough. Python stdlib only (3.11+).
"""
from __future__ import annotations

import argparse
import concurrent.futures as cf
import hashlib
import os
import re
import shlex
import subprocess
import sys
import time
import tomllib
from dataclasses import dataclass, field
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
RUNNERS_FILE = REPO / "runners.toml"
RUNNER_SCRIPTS = REPO / "scripts" / "runner"
JOBS_DIR = "$HOME/atlh-jobs"
SYNC_EXCLUDES = ["work/", "target/", ".git/", "__pycache__/"]
BOOTSTRAP_STEPS = ["packages", "rust", "sources", "wolfssl", "bionic", "vixl", "art", "opensles", "atl", "harness"]
NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]*$")
ARCH_CONFIG = {"x86_64": "config.toml", "aarch64": "config.aarch64.toml"}


class RigError(Exception):
    pass


# ---------------------------------------------------------------- registry

@dataclass
class Runner:
    name: str
    ssh: str
    arch: str
    config: str = "config.toml"
    dir: str = "atl-harness"
    distrobox: str | None = None
    jobs: int = 2
    make_jobs: int | None = None
    atl_src: str = "src/android_translation_layer"
    atl_git: str = "git@github-atl-fork:Alaxend0l/android-translation-layer.git"
    lima_host: str | None = None
    lima_instance: str | None = None
    notes: str = ""

    def home_path(self, p: str) -> str:
        """Shell expression for a path relative to the runner's $HOME."""
        return p if p.startswith("/") else f'"$HOME"/{shlex.quote(p)}'


RUNNER_KEYS = {f for f in Runner.__dataclass_fields__ if f != "name"}
REQUIRED_KEYS = {"ssh", "arch"}


@dataclass
class Registry:
    runners: dict[str, Runner] = field(default_factory=dict)
    default: str | None = None


def parse_registry(text: str) -> Registry:
    data = tomllib.loads(text)
    unknown = set(data) - {"default", "runners"}
    if unknown:
        raise RigError(f"runners.toml: unknown top-level keys {sorted(unknown)}")
    reg = Registry(default=data.get("default"))
    for name, d in data.get("runners", {}).items():
        if not NAME_RE.match(name):
            raise RigError(f"runners.toml: bad runner name {name!r}")
        if not isinstance(d, dict):
            raise RigError(f"runners.toml: [runners.{name}] must be a table")
        bad = set(d) - RUNNER_KEYS
        if bad:
            raise RigError(f"runners.toml: [runners.{name}] unknown keys {sorted(bad)}")
        missing = REQUIRED_KEYS - set(d)
        if missing:
            raise RigError(f"runners.toml: [runners.{name}] missing {sorted(missing)}")
        if ("lima_host" in d) != ("lima_instance" in d):
            raise RigError(f"runners.toml: [runners.{name}] needs both lima_host and lima_instance")
        reg.runners[name] = Runner(name=name, **d)
    if reg.default is not None and reg.default not in reg.runners:
        raise RigError(f"runners.toml: default {reg.default!r} is not a runner")
    return reg


def load_registry(path: Path = RUNNERS_FILE) -> Registry:
    if not path.exists():
        return Registry()
    return parse_registry(path.read_text())


def pick_runner(reg: Registry, name: str | None) -> Runner:
    name = name or os.environ.get("ATLH_RUNNER") or reg.default
    if not name:
        raise RigError("no runner given: use -r NAME, set ATLH_RUNNER, or set `default` in runners.toml")
    if name not in reg.runners:
        have = ", ".join(reg.runners) or "none; see `rig add`"
        raise RigError(f"unknown runner {name!r} (have: {have})")
    return reg.runners[name]


def runner_toml(r: Runner) -> str:
    """TOML block for one runner (used by `rig add`)."""
    lines = [f"[runners.{r.name}]"]
    for k in Runner.__dataclass_fields__:
        if k == "name":
            continue
        v = getattr(r, k)
        default = Runner.__dataclass_fields__[k].default
        if v is None or (v == default and k not in REQUIRED_KEYS | {"config", "jobs"}):
            continue
        lines.append(f"{k} = {v}" if isinstance(v, int) else f"{k} = {_toml_str(v)}")
    return "\n".join(lines) + "\n"


def _toml_str(s: str) -> str:
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


# ---------------------------------------------------------------- remote execution

def env_prefix(env: dict[str, str]) -> str:
    return "".join(f"export {k}={v}\n" for k, v in env.items())


def inner_script(r: Runner, script: str, args: list[str] = (), cd: bool = True,
                 env: dict[str, str] | None = None) -> str:
    """Bash script run inside the runner's environment."""
    parts = ['[ -f ~/.cargo/env ] && . ~/.cargo/env',
             'export PKG_CONFIG_PATH=/usr/local/lib64/pkgconfig:/usr/local/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}']
    if args:
        parts.append("set -- " + " ".join(shlex.quote(a) for a in args))
    if env:
        parts.append(env_prefix(env).rstrip("\n"))
    if cd:
        parts.append(f"cd {r.home_path(r.dir)} || {{ echo 'rig: no checkout at ~/{r.dir}; run rig sync' >&2; exit 3; }}")
    parts.append(script)
    return "\n".join(parts)


def wrap(r: Runner, inner: str) -> str:
    """Command string for ssh: enter the distrobox if configured, run bash -lc."""
    cmd = f"bash -lc {shlex.quote(inner)}"
    if r.distrobox:
        cmd = f"distrobox enter {shlex.quote(r.distrobox)} -- {cmd}"
    return cmd


def ssh_argv(host: str, command: str | None = None, tty: bool = False, batch: bool = True) -> list[str]:
    argv = ["ssh"]
    if batch:
        argv += ["-o", "BatchMode=yes", "-o", "ConnectTimeout=8"]
    argv.append("-t" if tty else "-T")
    argv.append(host)
    if command is not None:
        argv.append(command)
    return argv


def run_remote(r: Runner, script: str, args: list[str] = (), cd: bool = True, tty: bool = False,
               capture: bool = False, env: dict[str, str] | None = None, check: bool = False):
    argv = ssh_argv(r.ssh, wrap(r, inner_script(r, script, args, cd, env)), tty=tty)
    p = subprocess.run(argv, text=True, capture_output=capture)
    if check and p.returncode != 0:
        err = (p.stderr or "").strip() if capture else ""
        raise RigError(f"{r.name}: remote command failed ({p.returncode}){': ' + err if err else ''}")
    return p


def host_cmd(r: Runner, command: str, capture: bool = True) -> subprocess.CompletedProcess:
    """Run on the runner's ssh host directly (outside any distrobox)."""
    return subprocess.run(ssh_argv(r.ssh, f"bash -c {shlex.quote(command)}"), text=True, capture_output=capture)


def reachable(host: str, timeout: int = 4) -> bool:
    p = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", f"ConnectTimeout={timeout}", "-T", host, "true"],
                       capture_output=True)
    return p.returncode == 0


def script_text(name: str) -> str:
    return (RUNNER_SCRIPTS / name).read_text()


# ---------------------------------------------------------------- repo hashing

def local_repo_hash(root: Path = REPO) -> str:
    """Same value as the shell pipeline in scripts/runner/doctor.sh."""
    files = [p.relative_to(root).as_posix() for p in (root / "src").rglob("*") if p.is_file()]
    files += [n for n in ["Cargo.toml", "Cargo.lock"] if (root / n).is_file()]
    files += sorted(p.name for p in root.glob("config*.toml") if p.is_file())
    out = []
    for f in sorted(set(files), key=lambda s: s.encode()):
        out.append(f"{hashlib.sha256((root / f).read_bytes()).hexdigest()}  {f}\n")
    return hashlib.sha256("".join(out).encode()).hexdigest()


# ---------------------------------------------------------------- jobs

def check_job_name(name: str) -> str:
    if not NAME_RE.match(name):
        raise RigError(f"bad job name {name!r} (letters, digits, _ . -)")
    return name


def job_start_script(name: str, body: str, workdir: str) -> str:
    """Remote script that writes BODY to a file and runs it detached."""
    d = JOBS_DIR
    marker = "RIG_JOB_EOF_7f3a"
    if marker in body:
        raise RigError("job body contains the heredoc marker")
    return f"""set -e
mkdir -p {d}
if [ -f {d}/{name}.pid ] && kill -0 "$(cat {d}/{name}.pid)" 2>/dev/null; then
  echo "rig: job {name} is already running (pid $(cat {d}/{name}.pid))" >&2; exit 4
fi
rm -f {d}/{name}.exit
cat > {d}/{name}.sh <<'{marker}'
cd {workdir}
{body}
{marker}
setsid nohup bash -c 'bash "$1" > "$2" 2>&1; echo $? > "$3"' rig \\
  {d}/{name}.sh {d}/{name}.log {d}/{name}.exit < /dev/null > /dev/null 2>&1 &
echo $! > {d}/{name}.pid
echo "started job {name} (pid $!); log: ~/atlh-jobs/{name}.log"
"""


JOB_STATUS_SCRIPT = f"""shopt -s nullglob
for p in {JOBS_DIR}/*.pid; do
  n=$(basename "$p" .pid)
  [ -n "${{1:-}}" ] && [ "$n" != "$1" ] && continue
  if [ -f {JOBS_DIR}/$n.exit ]; then s="exit $(cat {JOBS_DIR}/$n.exit)"
  elif kill -0 "$(cat "$p")" 2>/dev/null; then s=running
  else s="died (no exit code)"; fi
  printf '%-24s %-20s %s\\n' "$n" "$s" "$(date -r {JOBS_DIR}/$n.log '+%F %T' 2>/dev/null)"
done
"""


def job_state(r: Runner, name: str) -> tuple[str, str | None]:
    p = run_remote(r, f"""p={JOBS_DIR}/{name}
if [ -f $p.exit ]; then echo "exit $(cat $p.exit)"
elif [ -f $p.pid ] && kill -0 "$(cat $p.pid)" 2>/dev/null; then echo running
elif [ -f $p.pid ]; then echo died
else echo missing; fi""", cd=False, capture=True)
    out = p.stdout.strip()
    if out.startswith("exit "):
        return "exit", out.split()[1]
    return out or "unreachable", None


# ---------------------------------------------------------------- commands

def cmd_list(reg: Registry, a) -> int:
    if not reg.runners:
        print("no runners; add one with: rig add NAME --ssh HOST")
        return 0
    with cf.ThreadPoolExecutor() as ex:
        up = dict(zip(reg.runners, ex.map(lambda r: reachable(r.ssh), reg.runners.values())))
    print(f"{'':2}{'name':12} {'ssh':14} {'arch':8} {'env':14} {'config':22} jobs  status")
    for n, r in reg.runners.items():
        envs = f"distrobox:{r.distrobox}" if r.distrobox else ("lima" if r.lima_host else "host")
        star = "*" if n == reg.default else " "
        print(f"{star} {n:12} {r.ssh:14} {r.arch:8} {envs:14} {r.config:22} {r.jobs:<5} "
              f"{'up' if up[n] else 'UNREACHABLE'}")
    return 0


def cmd_add(reg: Registry, a) -> int:
    if not NAME_RE.match(a.name):
        raise RigError(f"bad runner name {a.name!r}")
    if a.name in reg.runners:
        raise RigError(f"runner {a.name!r} already exists in runners.toml")
    probe = Runner(name=a.name, ssh=a.ssh, arch="?", distrobox=a.distrobox, dir=a.dir)
    print(f"probing {a.ssh}{' (distrobox ' + a.distrobox + ')' if a.distrobox else ''} ...")
    p = run_remote(probe, "echo \"$(uname -m) $(nproc) $(getconf PAGESIZE)\"", cd=False, capture=True)
    if p.returncode != 0:
        raise RigError(f"cannot run commands on {a.ssh}: {p.stderr.strip()}\n"
                       f"  check: ssh {a.ssh} true   (keys: ssh-copy-id {a.ssh})")
    arch, ncpu, page = p.stdout.split()[-3:]
    config = a.config or ARCH_CONFIG.get(arch)
    if not config:
        raise RigError(f"no default config for arch {arch}; pass --config")
    if not (REPO / config).exists():
        print(f"warning: {config} does not exist in the repo yet", file=sys.stderr)
    r = Runner(name=a.name, ssh=a.ssh, arch=arch, config=config, dir=a.dir, distrobox=a.distrobox,
               jobs=a.jobs or max(1, int(ncpu) // 3), make_jobs=a.make_jobs,
               lima_host=a.lima_host, lima_instance=a.lima_instance, notes=a.notes or "")
    block = runner_toml(r)
    parse_registry(block)  # validate before writing
    text = RUNNERS_FILE.read_text() if RUNNERS_FILE.exists() else ""
    if text and not text.endswith("\n\n"):
        text = text.rstrip("\n") + "\n\n"
    RUNNERS_FILE.write_text(text + block)
    print(f"added {a.name}: {arch}, {ncpu} cpus, page size {page}, config {config}, jobs {r.jobs}")
    if page != "4096":
        print("warning: non-4K page size; see docs/decisions.md D11", file=sys.stderr)
    print(f"next: rig -r {a.name} doctor   then   rig -r {a.name} bootstrap")
    return 0


def cmd_doctor(reg: Registry, a) -> int:
    targets = list(reg.runners.values()) if a.all else [pick_runner(reg, a.runner)]
    worst = 0
    for r in targets:
        worst = max(worst, doctor_one(r))
    return worst


def doctor_one(r: Runner) -> int:
    print(f"== {r.name} ({r.ssh})")
    rows: list[tuple[str, str, str, str]] = []
    if r.lima_host:
        p = subprocess.run(ssh_argv(r.lima_host, lima_cmd(r, "list --format '{{.Status}}' " + r.lima_instance)),
                           capture_output=True, text=True)
        st = p.stdout.strip() or "unknown"
        rows.append(("ok" if st == "Running" else "fail", "lima-vm", f"{r.lima_instance} on {r.lima_host}: {st}",
                     "" if st == "Running" else f"rig -r {r.name} up"))
    if not reachable(r.ssh):
        rows.append(("fail", "ssh", f"cannot reach {r.ssh}", f"ssh {r.ssh} true; ssh-copy-id {r.ssh}"))
        return print_rows(rows)
    rows.append(("ok", "ssh", r.ssh, ""))
    if r.distrobox:
        p = host_cmd(r, f"distrobox list --no-color 2>/dev/null | awk -F'|' '{{gsub(/ /,\"\",$2); print $2}}' "
                        f"| grep -qx {shlex.quote(r.distrobox)}")
        if p.returncode != 0:
            rows.append(("fail", "distrobox", f"{r.distrobox} not found",
                         f"ssh {r.ssh} distrobox create --name {r.distrobox} "
                         "--image registry.fedoraproject.org/fedora-toolbox:44"))
            return print_rows(rows)
        rows.append(("ok", "distrobox", r.distrobox, ""))
    t0 = time.time()
    env = {"EXPECT_ARCH": shlex.quote(r.arch), "HARNESS_DIR": r.home_path(r.dir)}
    p = run_remote(r, script_text("doctor.sh"), cd=False, capture=True, env=env)
    t1 = time.time()
    remote_hash = None
    for line in p.stdout.splitlines():
        if line.startswith("__clock__ "):
            skew = float(line.split()[1]) - (t0 + t1) / 2
            rows.append(("ok" if abs(skew) <= 5 else "warn", "clock-skew", f"{skew:+.1f} s vs workstation",
                         "" if abs(skew) <= 5 else
                         "`timedatectl` on both sides; fix the unsynced one: sudo timedatectl set-ntp true"))
            continue
        cols = line.split("\t")
        if len(cols) == 4:
            if cols[1] == "repo-hash" and cols[0] == "ok":
                remote_hash = cols[2]
                continue
            rows.append(tuple(cols))
    if p.returncode != 0 and not rows:
        rows.append(("fail", "doctor", p.stderr.strip()[:200], ""))
    if remote_hash:
        same = remote_hash == local_repo_hash()
        rows.append(("ok" if same else "warn", "repo-synced", "matches workstation" if same else "differs",
                     "" if same else f"rig -r {r.name} sync"))
    return print_rows(rows)


def print_rows(rows) -> int:
    mark = {"ok": "  ok ", "warn": " WARN", "fail": " FAIL"}
    for st, name, detail, hint in rows:
        print(f"{mark.get(st, st):5} {name:24} {detail}" + (f"\n{'':30}-> {hint}" if hint else ""))
    return 2 if any(r[0] == "fail" for r in rows) else (1 if any(r[0] == "warn" for r in rows) else 0)


def do_sync(r: Runner, quiet: bool = False) -> None:
    dest = r.dir.rstrip("/") + "/"
    has_rsync = host_cmd(r, "command -v rsync").returncode == 0
    if has_rsync:
        # No -t: changed files get the runner's mtime so cargo rebuilds even with
        # clock skew; --checksum skips unchanged files. See docs/decisions.md.
        argv = ["rsync", "-rlpz", "--checksum", "--delete"]
        for e in SYNC_EXCLUDES:
            argv += ["--exclude", e]
        argv += ["-e", "ssh -o BatchMode=yes", f"{REPO}/", f"{r.ssh}:{dest}"]
        p = subprocess.run(argv)
    else:
        # Fresh machines may lack rsync: tar, extracting with -m (fresh mtimes).
        ex = " ".join(f"--exclude=./{e.rstrip('/')}" for e in SYNC_EXCLUDES)
        tar = subprocess.Popen(f"tar -C {shlex.quote(str(REPO))} {ex} -czf - .", shell=True, stdout=subprocess.PIPE)
        p = subprocess.run(ssh_argv(r.ssh, f"bash -c {shlex.quote(f'mkdir -p ~/{dest} && tar -xzmf - -C ~/{dest}')}"),
                           stdin=tar.stdout)
        tar.wait()
    if p.returncode != 0:
        raise RigError(f"{r.name}: sync failed")
    if not quiet:
        print(f"synced -> {r.name}:~/{dest}" + ("" if has_rsync else " (tar; no rsync on runner)"))


def cmd_sync(reg: Registry, a) -> int:
    for r in (reg.runners.values() if a.all else [pick_runner(reg, a.runner)]):
        do_sync(r)
    return 0


def atlh_script(r: Runner, args: list[str]) -> str:
    argv = ["cargo", "run", "--release", "--quiet", "--", "--config", r.config, *args]
    return " ".join(shlex.quote(x) for x in argv)


def cmd_atlh(reg: Registry, a) -> int:
    r = pick_runner(reg, a.runner)
    args = a.args[1:] if a.args[:1] == ["--"] else a.args
    if a.jobs_default and args[:1] == ["run"] and "--jobs" not in args:
        args = [*args, "--jobs", str(r.jobs)]
    if not a.no_sync:
        do_sync(r, quiet=True)
    if a.detach:
        return start_job(r, check_job_name(a.detach), atlh_script(r, args))
    return run_remote(r, atlh_script(r, args)).returncode


def cmd_sh(reg: Registry, a) -> int:
    r = pick_runner(reg, a.runner)
    cmd = a.cmd[1:] if a.cmd[:1] == ["--"] else a.cmd
    if not cmd:
        return run_remote(r, "exec bash -l", tty=True, cd=not a.home).returncode
    script = cmd[0] if len(cmd) == 1 else " ".join(shlex.quote(c) for c in cmd)
    return run_remote(r, script, cd=not a.home).returncode


def cmd_pull(reg: Registry, a) -> int:
    r = pick_runner(reg, a.runner)
    local = REPO / "work" / "remote" / r.name
    local.mkdir(parents=True, exist_ok=True)
    src = f"{r.ssh}:{r.dir.rstrip('/')}/work/"
    argv = ["rsync", "-rltz", "-e", "ssh -o BatchMode=yes"]
    if a.run:
        argv += ["--include", "atlh.sqlite", "--include", "runs/", "--include", f"runs/{a.run}/***",
                 "--exclude", "*"]
    else:
        argv += ["--exclude", "apks/", "--exclude", "index-v2.json"]
    p = subprocess.run(argv + [src, f"{local}/"])
    if p.returncode == 0:
        print(f"pulled -> {local.relative_to(REPO)}/")
    return p.returncode


def start_job(r: Runner, name: str, body: str, workdir: str | None = None) -> int:
    script = job_start_script(name, body, workdir or r.home_path(r.dir))
    rc = run_remote(r, script, cd=False).returncode
    if rc == 0:
        print(f"follow: rig -r {r.name} job log {name} -f    wait: rig -r {r.name} job wait {name}")
    return rc


def cmd_job(reg: Registry, a) -> int:
    r = pick_runner(reg, a.runner)
    if a.job_cmd == "start":
        cmd = a.cmd[1:] if a.cmd[:1] == ["--"] else a.cmd
        if not cmd:
            raise RigError("job start NAME -- COMMAND...")
        body = cmd[0] if len(cmd) == 1 else " ".join(shlex.quote(c) for c in cmd)
        return start_job(r, check_job_name(a.name), body)
    if a.job_cmd == "status":
        return run_remote(r, JOB_STATUS_SCRIPT, args=[a.name] if a.name else [], cd=False).returncode
    name = check_job_name(a.name)
    if a.job_cmd == "log":
        f = f"{JOBS_DIR}/{name}.log"
        tail = f"tail -n {int(a.lines)} -F {f}" if a.follow else f"tail -n {int(a.lines)} {f}"
        return run_remote(r, tail, cd=False, tty=a.follow).returncode
    if a.job_cmd == "stop":
        return run_remote(r, f'kill -- -"$(cat {JOBS_DIR}/{name}.pid)" && echo stopped {name}', cd=False).returncode
    if a.job_cmd == "wait":
        return wait_job(r, name, a.interval)
    raise RigError(a.job_cmd)


def wait_job(r: Runner, name: str, interval: int = 20) -> int:
    last = None
    while True:
        st, code = job_state(r, name)
        if st != last:
            print(f"[{time.strftime('%T')}] {name}: {st}{' ' + code if code else ''}", flush=True)
            last = st
        if st == "exit":
            run_remote(r, f"tail -n 15 {JOBS_DIR}/{name}.log", cd=False)
            return int(code or 1)
        if st in ("died", "missing"):
            run_remote(r, f"tail -n 15 {JOBS_DIR}/{name}.log 2>/dev/null", cd=False)
            return 1
        time.sleep(interval)  # "unreachable" retries: network blips are survivable


def cmd_bootstrap(reg: Registry, a) -> int:
    r = pick_runner(reg, a.runner)
    steps = BOOTSTRAP_STEPS
    if a.only:
        steps = a.only.split(",")
    elif a.from_step:
        if a.from_step not in steps:
            raise RigError(f"unknown step {a.from_step} (have {', '.join(steps)})")
        steps = steps[steps.index(a.from_step):]
    bad = [s for s in steps if s not in BOOTSTRAP_STEPS]
    if bad:
        raise RigError(f"unknown steps {bad} (have {', '.join(BOOTSTRAP_STEPS)})")
    do_sync(r)
    env = {
        "HARNESS_DIR": r.home_path(r.dir),
        "ATL_SRC": r.home_path(r.atl_src),
        "ATL_GIT": shlex.quote(r.atl_git),
        "STEPS": shlex.quote(" ".join(steps)),
        "FORCE": "1" if a.force else "0",
    }
    if r.make_jobs:
        env["MAKE_JOBS"] = str(r.make_jobs)
    body = env_prefix(env) + f"bash {r.home_path(r.dir)}/scripts/runner/bootstrap.sh"
    rc = start_job(r, "bootstrap", body)
    if rc == 0 and a.wait:
        return wait_job(r, "bootstrap")
    return rc


def cmd_rebuild_atl(reg: Registry, a) -> int:
    r = pick_runner(reg, a.runner)
    src = r.home_path(r.atl_src)
    script = f"""set -euo pipefail
cd {src}
{"git fetch --all --quiet && git checkout --quiet " + shlex.quote(a.ref) if a.ref else ":"}
{"git pull --ff-only --quiet" if a.pull else ":"}
echo "building $(git log -1 --format='%h %s')"
meson compile -C builddir
sudo meson install -C builddir > /dev/null
sudo ldconfig
echo "installed $(command -v android-translation-layer) from $(git rev-parse --short HEAD)"
"""
    if a.detach:
        return start_job(r, "rebuild-atl", script, workdir=src)
    return run_remote(r, script, cd=False).returncode


def cmd_smoke(reg: Registry, a) -> int:
    r = pick_runner(reg, a.runner)
    apk = a.apk
    remote_apk = apk
    if Path(apk).is_file():
        remote_apk = f"atlh-smoke/apks/{Path(apk).name}"
        run_remote(r, "mkdir -p ~/atlh-smoke/apks", cd=False, check=True)
        if subprocess.run(["scp", "-q", "-o", "BatchMode=yes", apk, f"{r.ssh}:{remote_apk}"]).returncode:
            raise RigError("upload failed")
    stem = re.sub(r"[^A-Za-z0-9_.-]", "_", Path(apk).stem)
    rdir = f"atlh-smoke/out/{stem}"
    atl_args = a.atl_args[1:] if a.atl_args[:1] == ["--"] else a.atl_args
    args = [rdir, str(a.settle), str(a.crop), remote_apk, *atl_args]
    # Sent inline from this checkout (no sync needed); paths are relative to
    # $HOME, the script's working directory.
    p = run_remote(r, script_text("smoke.sh"), args=args, cd=False, capture=True)
    sys.stderr.write(p.stderr)
    if p.returncode != 0:
        print(p.stdout)
        return p.returncode
    local = REPO / "work" / "remote" / r.name / "smoke" / stem
    local.mkdir(parents=True, exist_ok=True)
    subprocess.run(["scp", "-q", "-o", "BatchMode=yes", f"{r.ssh}:{rdir}/run.log", f"{r.ssh}:{rdir}/shot.png",
                    f"{local}/"], stderr=subprocess.DEVNULL)
    print(p.stdout.rstrip())
    print(f"log:  {local.relative_to(REPO)}/run.log")
    if (local / "shot.png").exists():
        print(f"shot: {local.relative_to(REPO)}/shot.png")
    return 0


def lima_cmd(r: Runner, sub: str) -> str:
    # The Lima host may run fish/zsh: keep it to `env ... limactl ...`.
    return f"env PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin limactl {sub}"


def cmd_up_down(reg: Registry, a) -> int:
    r = pick_runner(reg, a.runner)
    if not r.lima_host:
        raise RigError(f"{r.name} has no lima_host/lima_instance; nothing to start or stop")
    sub = f"{'start' if a.command == 'up' else 'stop'} --tty=false {shlex.quote(r.lima_instance)}"
    rc = subprocess.run(ssh_argv(r.lima_host, lima_cmd(r, sub))).returncode
    if rc == 0 and a.command == "up":
        print("up" if reachable(r.ssh, timeout=10) else f"started, but ssh {r.ssh} does not answer yet")
    return rc


# ---------------------------------------------------------------- CLI

def build_parser() -> argparse.ArgumentParser:
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("-r", "--runner", default=argparse.SUPPRESS,
                        help="runner name (default: $ATLH_RUNNER, then `default` in runners.toml)")
    ap = argparse.ArgumentParser(prog="rig", parents=[common], description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sp = ap.add_subparsers(dest="command", required=True, metavar="COMMAND")

    def sub(name, help_, **kw):
        return sp.add_parser(name, parents=[common], help=help_, description=help_, **kw)

    sub("list", "list runners and whether they answer")

    p = sub("add", "register a runner (probes arch/cpus over ssh) in runners.toml")
    p.add_argument("name")
    p.add_argument("--ssh", required=True, help="ssh destination or ~/.ssh/config alias")
    p.add_argument("--distrobox", help="run inside this distrobox on the host")
    p.add_argument("--dir", default="atl-harness", help="harness checkout, relative to ~ (default %(default)s)")
    p.add_argument("--config", help="harness config (default: by arch, e.g. config.aarch64.toml)")
    p.add_argument("--jobs", type=int, help="default --jobs for `atlh run` (default: cpus/3)")
    p.add_argument("--make-jobs", type=int, help="parallel compile jobs for bootstrap (default: cpus)")
    p.add_argument("--lima-host", help="ssh alias of the machine hosting this runner's Lima VM")
    p.add_argument("--lima-instance", help="Lima instance name")
    p.add_argument("--notes")

    p = sub("doctor", "check a runner: ssh, toolchain, ATL, disk, clock, sync state")
    p.add_argument("--all", action="store_true", help="check every runner")

    p = sub("sync", "copy this checkout (minus work/, target/, .git/) to the runner")
    p.add_argument("--all", action="store_true", help="sync every runner")

    p = sub("atlh", "sync, then run atlh on the runner with its config",
            epilog="example: rig -r mini atlh run --run-id base   (adds --jobs from runners.toml)")
    p.add_argument("--detach", metavar="JOB", help="run as a detached job (survives ssh drops)")
    p.add_argument("--no-sync", action="store_true", help="skip the automatic sync")
    p.add_argument("--no-default-jobs", dest="jobs_default", action="store_false",
                   help="don't add --jobs from runners.toml to `run`")
    p.add_argument("args", nargs=argparse.REMAINDER, help="atlh arguments")

    p = sub("sh", "shell (or one command) inside the runner's environment, in the checkout")
    p.add_argument("--home", action="store_true", help="start in ~ instead of the checkout")
    p.add_argument("cmd", nargs=argparse.REMAINDER, help="command; quote it to use pipes/&&")

    p = sub("pull", "copy work/ back (no APKs) into work/remote/RUNNER/")
    p.add_argument("--run", help="only this run id (plus the database)")

    p = sub("job", "detached long-running commands on the runner")
    jp = p.add_subparsers(dest="job_cmd", required=True, metavar="ACTION")
    j = jp.add_parser("start", parents=[common], help="start: job start NAME -- COMMAND...")
    j.add_argument("name")
    j.add_argument("cmd", nargs=argparse.REMAINDER)
    j = jp.add_parser("status", parents=[common], help="list jobs (or one)")
    j.add_argument("name", nargs="?")
    j = jp.add_parser("log", parents=[common], help="show a job's log")
    j.add_argument("name")
    j.add_argument("-n", "--lines", default=40)
    j.add_argument("-f", "--follow", action="store_true")
    j = jp.add_parser("wait", parents=[common], help="wait for a job, then show its log tail")
    j.add_argument("name")
    j.add_argument("--interval", type=int, default=20)
    j = jp.add_parser("stop", parents=[common], help="kill a job's process group")
    j.add_argument("name")

    p = sub("bootstrap", "build Fedora packages, Rust, ART, ATL and atlh on the runner (detached job)",
            epilog=f"steps: {' '.join(BOOTSTRAP_STEPS)}. Done steps are skipped unless --force.")
    p.add_argument("--only", help="comma-separated steps")
    p.add_argument("--from", dest="from_step", help="start at this step")
    p.add_argument("--force", action="store_true", help="redo steps already done")
    p.add_argument("--wait", action="store_true", help="wait for the job to finish")

    p = sub("rebuild-atl", "recompile and reinstall ATL from the runner's checkout")
    p.add_argument("--ref", help="git checkout this ref first (branch/tag/commit)")
    p.add_argument("--pull", action="store_true", help="git pull --ff-only first")
    p.add_argument("--detach", action="store_true", help="run as job `rebuild-atl`")

    p = sub("smoke", "run one APK under ATL + Xvfb; fetch screenshot and log",
            epilog="APK: a local file (uploaded) or a path on the runner relative to ~. "
                   "Extra ATL args after --, e.g. -- -l org/example/MainActivity")
    p.add_argument("apk")
    p.add_argument("--settle", type=int, default=20, help="seconds before screenshot (default %(default)s)")
    p.add_argument("--crop", type=int, default=50, help="title bar rows skipped when scoring (default %(default)s)")
    p.add_argument("atl_args", nargs="*", metavar="-- ATL_ARGS", help="extra ATL arguments, after --")

    sub("up", "start the runner's Lima VM")
    sub("down", "stop the runner's Lima VM")
    return ap


COMMANDS = {
    "list": cmd_list, "add": cmd_add, "doctor": cmd_doctor, "sync": cmd_sync, "atlh": cmd_atlh,
    "sh": cmd_sh, "pull": cmd_pull, "job": cmd_job, "bootstrap": cmd_bootstrap,
    "rebuild-atl": cmd_rebuild_atl, "smoke": cmd_smoke, "up": cmd_up_down, "down": cmd_up_down,
}


def main(argv: list[str] | None = None) -> int:
    sys.stdout.reconfigure(line_buffering=True)  # keep order with child process output
    a = build_parser().parse_args(argv)
    if not hasattr(a, "runner"):
        a.runner = None
    try:
        return COMMANDS[a.command](load_registry(), a)
    except RigError as e:
        print(f"rig: {e}", file=sys.stderr)
        return 2
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
